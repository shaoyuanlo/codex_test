<dialog class="gallery-dialog" aria-label="Photo and video viewer">
  <button class="button gallery-close" type="button" data-gallery-close aria-label="Close viewer">Close <span aria-hidden="true">×</span></button>
  <img data-gallery-full alt="">
  <video data-gallery-player controls playsinline preload="none" hidden></video>
  <p class="gallery-caption" data-gallery-caption></p>
</dialog>
<script src="{{ '/assets/gallery.js' | url }}" defer></script>
